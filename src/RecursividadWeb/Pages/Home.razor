@page "/"

<PageTitle>Práctica de Recursividad</PageTitle>

<section class="hero">
    <span class="eyebrow">Estructura de Datos</span>
    <h1>Práctica de <span>Recursividad</span></h1>
    <p>Selecciona un ejercicio para consultar su enunciado, implementación y explicación.</p>
</section>

<section class="exercise-grid" aria-label="Ejercicios de la práctica">
