    <ExerciseCard Number="2" Title="Fibonacci" Summary="Generación recursiva de la serie de Fibonacci." Route="ejercicio-2" />
    <ExerciseCard Number="3" Title="Máximo Común Divisor" Summary="Cálculo del MCD de dos números enteros." Route="ejercicio-3" />
    <ExerciseCard Number="4" Title="Cambio de monedas" Summary="Obtención del cambio con el mínimo número de piezas." Route="ejercicio-4" />
    <ExerciseCard Number="5" Title="Torres de Hanói" Summary="Descripción recursiva de los movimientos entre torres." Route="ejercicio-5" />
</section>
